#!/usr/bin/env bash
# bin/sync-shipwright-theme — pull design tokens from shipwright-ui
#
# Usage:
#   bin/sync-shipwright-theme           # syncs from headwayio/shipwright-ui@main
#   bin/sync-shipwright-theme v0.0.1    # syncs from a specific tag
#   bin/sync-shipwright-theme abc123    # syncs from a specific commit SHA
#
# Source of truth: headwayio/shipwright-ui/packages/theme/src/tokens.css
# That file is committed and generated by `pnpm generate` from the .ts
# token definitions in the same directory; pulling its raw contents gives
# us a Tailwind 4 @theme block ready to drop into a CSS pipeline.
#
# Outputs:
#   app/assets/tailwind/shipwright/tokens.css  — token block + generated header
#   .shipwright-theme-sha                       — commit SHA we synced from
#
# Requirements: gh CLI authenticated (https://cli.github.com/).

set -euo pipefail

SOURCE_REPO="headwayio/shipwright-ui"
SOURCE_PATH="packages/theme/src/tokens.css"
REF="${1:-main}"
TARGET_FILE="app/assets/tailwind/shipwright/tokens.css"
SHA_FILE=".shipwright-theme-sha"

if ! command -v gh > /dev/null; then
  echo "error: gh CLI not found. Install from https://cli.github.com/." >&2
  exit 1
fi

# Resolve REF → full commit SHA so the pin is stable even if a branch moves.
SHA=$(gh api "repos/${SOURCE_REPO}/commits/${REF}" -q .sha)
SHORT_SHA="${SHA:0:7}"

echo "→ Fetching ${SOURCE_PATH} from ${SOURCE_REPO}@${SHORT_SHA}"

# Pull the raw file contents.
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

gh api "repos/${SOURCE_REPO}/contents/${SOURCE_PATH}?ref=${SHA}" \
  -H "Accept: application/vnd.github.raw" \
  > "$TMP"

# Write target with a generated header. The header must be the first thing
# tests grep for — see test/integration/tokens_sync_test.rb (added in the
# rename PR).
mkdir -p "$(dirname "$TARGET_FILE")"
{
  printf '/*\n'
  printf ' * GENERATED FROM %s@%s — DO NOT EDIT\n' "$SOURCE_REPO" "$SHA"
  printf ' *\n'
  printf ' * To update, run: bin/sync-shipwright-theme [ref]\n'
  printf ' * Source: https://github.com/%s/blob/%s/%s\n' "$SOURCE_REPO" "$SHA" "$SOURCE_PATH"
  printf ' */\n'
  printf '\n'
  cat "$TMP"
} > "$TARGET_FILE"

# Pin the SHA for CI verification.
echo "$SHA" > "$SHA_FILE"

echo "✓ Synced ${SOURCE_REPO}@${SHORT_SHA} → ${TARGET_FILE}"
echo "  Pinned in ${SHA_FILE}"

# If invoked as a non-CI human, remind them what to do next.
if [[ -z "${CI:-}" ]]; then
  echo
  echo "Next steps:"
  echo "  1. Diff: git diff ${TARGET_FILE} ${SHA_FILE}"
  echo "  2. If component class names need updates, run the rename in a follow-up commit."
  echo "  3. Run the test suite + walk every Lookbook preview before opening the PR."
fi
