<%= content_tag :div,
  id: id,
  class: wrapper_classes,
  role: "status",
  "aria-live": "polite",
  "aria-atomic": "true",
  data: {
    shipwright_toast: true,
    "shipwright-toast-state": "entering",
    "shipwright-toast-duration": duration_ms
  },
  **html_attrs do %>
  <span class="<%= icon_circle_classes %>" aria-hidden="true">
    <%= render Shipwright::IconComponent.new(name: variant_icon, size: :sm) %>
  </span>

  <div class="flex-1 min-w-0 pt-0.5">
    <p class="text-sm font-semibold leading-5 truncate"><%= title %></p>
    <% if body.present? %>
      <p class="text-sm leading-5 text-text-inverse/80 break-words"><%= body %></p>
    <% end %>
  </div>

  <% if dismissible? %>
    <button type="button"
            class="shrink-0 self-start p-1 -m-1 rounded-sm text-text-inverse/80 hover:text-text-inverse transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-text-inverse"
            data-shipwright-toast-dismiss
            aria-label="Dismiss notification">
      <%= render Shipwright::IconComponent.new(name: :x, size: :sm) %>
    </button>
  <% end %>
<% end %>

<%= Shipwright::ToastComponent.init_script_html %>
