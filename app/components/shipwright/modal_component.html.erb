<%= content_tag :dialog,
  id: id,
  class: dialog_classes,
  data: {
    shipwright_modal: true,
    "shipwright-modal-state": initially_open? ? "open" : "closed",
    "shipwright-modal-size": size,
    "initially-open": (initially_open? ? "true" : nil)
  },
  "aria-labelledby": (title.present? ? "#{id}-title" : nil),
  **html_attrs do %>

  <div class="<%= panel_classes %>">
    <% if has_header? %>
      <div class="<%= header_classes %>">
        <% if header? %>
          <%= header %>
        <% elsif has_default_header? %>
          <div class="flex flex-col gap-2xs min-w-0">
            <% if title.present? %>
              <h2 id="<%= id %>-title" class="text-lg font-semibold truncate"><%= title %></h2>
            <% end %>
            <% if subtitle.present? %>
              <p class="text-sm text-text-secondary"><%= subtitle %></p>
            <% end %>
          </div>
        <% else %>
          <span></span>
        <% end %>

        <% if close_button? %>
          <button type="button"
                  class="<%= close_button_classes %>"
                  data-shipwright-modal-close="<%= id %>"
                  aria-label="Close">
            <%= render Shipwright::IconComponent.new(name: :x, size: :sm) %>
          </button>
        <% end %>
      </div>
    <% end %>

    <div class="<%= body_classes %>">
      <%= content %>
    </div>

    <% if actions.any? %>
      <div class="<%= footer_classes %>">
        <% actions.each do |action| %>
          <%= action %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= init_script_tag("data-shipwright-modal-init", Shipwright::ModalComponent::INIT_SCRIPT_BODY) %>
<% end %>
