<div style="padding: 2rem; font-family: system-ui;">
  <h1>Shipwright Components</h1>

  <h2>Button — Hierarchies</h2>
  <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;">
    <%= render Shipwright::ButtonComponent.new(hierarchy: :primary) do %>Primary<% end %>
    <%= render Shipwright::ButtonComponent.new(hierarchy: :secondary) do %>Secondary<% end %>
    <%= render Shipwright::ButtonComponent.new(hierarchy: :tertiary) do %>Tertiary<% end %>
    <%= render Shipwright::ButtonComponent.new(hierarchy: :destructive) do %>Destructive<% end %>
  </div>

  <h2>Button — Sizes</h2>
  <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1rem;">
    <%= render Shipwright::ButtonComponent.new(size: :sm) do %>Small<% end %>
    <%= render Shipwright::ButtonComponent.new(size: :md) do %>Medium<% end %>
    <%= render Shipwright::ButtonComponent.new(size: :lg) do %>Large<% end %>
  </div>

  <h2>Button — Shape</h2>
  <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1rem;">
    <%= render Shipwright::ButtonComponent.new(shape: :rounded) do %>Rounded<% end %>
    <%= render Shipwright::ButtonComponent.new(shape: :pill) do %>Pill<% end %>
  </div>

  <h2>Button — Icon Only</h2>
  <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1rem;">
    <%= render Shipwright::ButtonComponent.new(icon_only: true, size: :sm) do %>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3v10M3 8h10"/></svg>
    <% end %>
    <%= render Shipwright::ButtonComponent.new(icon_only: true, size: :md) do %>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 3v14M3 10h14"/></svg>
    <% end %>
    <%= render Shipwright::ButtonComponent.new(icon_only: true, size: :lg) do %>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v16M4 12h16"/></svg>
    <% end %>
    <%= render Shipwright::ButtonComponent.new(icon_only: true, shape: :pill) do %>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 3v14M3 10h14"/></svg>
    <% end %>
  </div>

  <h2>Button — Disabled</h2>
  <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1rem;">
    <%= render Shipwright::ButtonComponent.new(hierarchy: :primary, disabled: true) do %>Primary Disabled<% end %>
    <%= render Shipwright::ButtonComponent.new(hierarchy: :secondary, disabled: true) do %>Secondary Disabled<% end %>
    <%= render Shipwright::ButtonComponent.new(hierarchy: :destructive, disabled: true) do %>Destructive Disabled<% end %>
  </div>

  <h2>Button — Class Override</h2>
  <div style="margin-bottom: 1rem;">
    <%= render Shipwright::ButtonComponent.new(class: "w-full") do %>Full Width Override<% end %>
  </div>

  <h2 style="margin-top: 3rem;">Button Group</h2>
  <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1rem;">
    <div>
      <h3>Compact Horizontal</h3>
      <%= render Shipwright::ButtonGroupComponent.new(density: :compact, orientation: :horizontal) do |group| %>
        <% group.with_button(hierarchy: :secondary) do %>Edit<% end %>
        <% group.with_button(hierarchy: :secondary) do %>Copy<% end %>
        <% group.with_button(hierarchy: :secondary) do %>Delete<% end %>
      <% end %>
    </div>

    <div>
      <h3>Regular Horizontal</h3>
      <%= render Shipwright::ButtonGroupComponent.new(density: :regular, orientation: :horizontal) do |group| %>
        <% group.with_button(hierarchy: :secondary) do %>Edit<% end %>
        <% group.with_button(hierarchy: :secondary) do %>Copy<% end %>
        <% group.with_button(hierarchy: :secondary) do %>Delete<% end %>
      <% end %>
    </div>

    <div>
      <h3>Compact Vertical</h3>
      <%= render Shipwright::ButtonGroupComponent.new(density: :compact, orientation: :vertical) do |group| %>
        <% group.with_button(hierarchy: :secondary) do %>Edit<% end %>
        <% group.with_button(hierarchy: :secondary) do %>Copy<% end %>
        <% group.with_button(hierarchy: :secondary) do %>Delete<% end %>
      <% end %>
    </div>
  </div>
</div>
