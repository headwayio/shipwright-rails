<div style="padding: 2rem;">
  <%= render(Shipwright::TableComponent.new(selectable: true)) do |t| %>
    <% t.with_column(label: "Person", sortable: true) %>
    <% t.with_column(label: "Status") %>
    <% t.with_column(label: "Progress") %>

    <% [["Wendy Sullivan", "WS", :online, 30],
        ["John Legend", "JL", :away, 65],
        ["Alex Lee", "AL", :busy, 100]].each do |name, initials, status, pct| %>
      <% t.with_row do |row| %>
        <% row.with_cell do %>
          <div class="flex items-center gap-2">
            <%= render Shipwright::AvatarComponent.new(initials: initials, size: :sm, status: status) %>
            <div class="flex flex-col">
              <span class="font-medium"><%= name %></span>
              <span class="text-xs text-text-disabled">Team member</span>
            </div>
          </div>
        <% end %>
        <% row.with_cell do %>
          <span class="inline-flex items-center gap-1.5">
            <%= render Shipwright::BadgeComponent.new(sentiment: (status == :online ? :positive : (status == :away ? :warning : :negative)), size: :sm) %>
            <%= status.to_s.capitalize %>
          </span>
        <% end %>
        <% row.with_cell do %>
          <div class="flex items-center gap-2">
            <div class="flex-1 h-1.5 rounded-full bg-background-secondary overflow-hidden">
              <div class="h-full bg-interactive-primary-default" style="width: <%= pct %>%"></div>
            </div>
            <span class="text-xs text-text-disabled w-10 text-right"><%= pct %>%</span>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
