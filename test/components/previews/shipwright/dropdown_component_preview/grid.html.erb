<div style="padding: 2rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
  <%= render(Shipwright::DropdownComponent.new(name: "g1", label: "Label", caption: "Caption")) do |d| %>
    <% d.with_item(value: "folders", icon: :folder, primary: "Folders",   secondary: "Organize your files") %>
    <% d.with_item(value: "starred", icon: :star,   primary: "Starred",   secondary: "Your favorites") %>
    <% d.with_item(value: "trash",   icon: :trash,  primary: "Trash",     secondary: "Deleted items") %>
  <% end %>

  <%= render(Shipwright::DropdownComponent.new(name: "g2", label: "Label", value: "folders", caption: "Caption")) do |d| %>
    <% d.with_item(value: "folders", icon: :folder, primary: "Folders") %>
    <% d.with_item(value: "starred", icon: :star,   primary: "Starred") %>
  <% end %>

  <%= render(Shipwright::DropdownComponent.new(name: "g3", label: "Label", caption: "Caption", disabled: true)) %>

  <%= render(Shipwright::DropdownComponent.new(name: "g4", label: "Label", value: "a", variant: :destructive, caption: "Error message")) do |d| %>
    <% d.with_item(value: "a", primary: "Primary Text") %>
    <% d.with_item(value: "b", primary: "Other") %>
  <% end %>
</div>
