<div style="min-height: 60vh; padding: 2rem; display: flex; flex-direction: column; gap: 1rem;">
  <p style="color: #555; font-family: sans-serif; font-size: 0.9rem;">
    Click a button to append a toast to the container (top-right). Toasts auto-dismiss after 5s;
    hover to pause the timer. The sticky one stays until you click ✕.
  </p>

  <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
    <button type="button" onclick="addToast('success', 'Saved', 'Your changes are live.')" style="padding: 0.5rem 1rem; border-radius: 6px; background: #16a34a; color: white; border: 0; cursor: pointer;">Success</button>
    <button type="button" onclick="addToast('error', 'Oops', 'Something went wrong.')" style="padding: 0.5rem 1rem; border-radius: 6px; background: #dc2626; color: white; border: 0; cursor: pointer;">Error</button>
    <button type="button" onclick="addToast('warning', 'Heads up', 'Disk almost full.')" style="padding: 0.5rem 1rem; border-radius: 6px; background: #ca8a04; color: white; border: 0; cursor: pointer;">Warning</button>
    <button type="button" onclick="addToast('info', 'Tip', 'You can drag to reorder.')" style="padding: 0.5rem 1rem; border-radius: 6px; background: #2563eb; color: white; border: 0; cursor: pointer;">Info</button>
    <button type="button" onclick="addToast('neutral', 'Syncing', 'Just a moment...', 0)" style="padding: 0.5rem 1rem; border-radius: 6px; background: #27303f; color: white; border: 0; cursor: pointer;">Sticky</button>
  </div>
</div>

<%= render Shipwright::ToastContainerComponent.new %>

<%# Pre-rendered toast templates by variant, cloned into the container on click. %>
<template id="toast-tmpl-success"><%= render(Shipwright::ToastComponent.new(title: "__T__", body: "__B__", variant: :success)) %></template>
<template id="toast-tmpl-error"><%= render(Shipwright::ToastComponent.new(title: "__T__", body: "__B__", variant: :error)) %></template>
<template id="toast-tmpl-warning"><%= render(Shipwright::ToastComponent.new(title: "__T__", body: "__B__", variant: :warning)) %></template>
<template id="toast-tmpl-info"><%= render(Shipwright::ToastComponent.new(title: "__T__", body: "__B__", variant: :info)) %></template>
<template id="toast-tmpl-neutral"><%= render(Shipwright::ToastComponent.new(title: "__T__", body: "__B__", variant: :neutral, duration: 0)) %></template>

<script>
  function addToast(variant, title, body, duration) {
    var tmpl = document.getElementById("toast-tmpl-" + variant);
    if (!tmpl) return;
    var html = tmpl.innerHTML.replace("__T__", title).replace("__B__", body);
    var frag = document.createElement("div");
    frag.innerHTML = html;
    var toast = frag.querySelector("[data-shipwright-toast]");
    // Give each toast a unique id so the activator treats it as new.
    toast.id = "toast-" + Date.now() + "-" + Math.floor(Math.random() * 1000);
    if (typeof duration === "number") toast.dataset.shipwrightToastDuration = duration;
    document.getElementById("<%= Shipwright::ToastContainerComponent::DOM_ID %>").appendChild(toast);
    if (window.__shipwrightToastActivate) window.__shipwrightToastActivate();
  }
</script>
