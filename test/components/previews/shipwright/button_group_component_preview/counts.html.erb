    <h3 style="margin-bottom: 0.5rem;">2 buttons</h3>
    <%= render Shipwright::ButtonGroupComponent.new do |group| %>
      <% group.with_button(hierarchy: :secondary) do %>Edit<% end %>
      <% group.with_button(hierarchy: :secondary) do %>Move<% end %>
    <% end %>
  </div>
  <div>
