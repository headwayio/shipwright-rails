<div style="display: flex; gap: 1rem; align-items: center; padding: 2rem;">
  <%= render Shipwright::ButtonComponent.new(icon_only: true, size: :sm) do %>
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5"/></svg>
  <% end %>
  <%= render Shipwright::ButtonComponent.new(icon_only: true, size: :md) do %>
    <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M10 3v14M3 10h14" stroke="currentColor" stroke-width="1.5"/></svg>
  <% end %>
  <%= render Shipwright::ButtonComponent.new(icon_only: true, size: :lg) do %>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4v16M4 12h16" stroke="currentColor" stroke-width="2"/></svg>
  <% end %>
  <%= render Shipwright::ButtonComponent.new(icon_only: true, shape: :pill, size: :md) do %>
    <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M10 3v14M3 10h14" stroke="currentColor" stroke-width="1.5"/></svg>
  <% end %>
