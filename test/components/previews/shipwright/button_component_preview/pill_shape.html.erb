<div style="display: grid; grid-template-columns: repeat(4, auto); gap: 1rem; padding: 2rem; justify-content: start;">
  <%= render Shipwright::ButtonComponent.new(shape: :pill, hierarchy: :primary) { "Primary" } %>
  <%= render Shipwright::ButtonComponent.new(shape: :pill, hierarchy: :secondary) { "Secondary" } %>
  <%= render Shipwright::ButtonComponent.new(shape: :pill, hierarchy: :tertiary) { "Tertiary" } %>
  <%= render Shipwright::ButtonComponent.new(shape: :pill, hierarchy: :destructive) { "Destructive" } %>
</div>
