<%# Live form demonstrating native HTML5 validation — try submitting with
    missing or malformed values to see the browser's built-in messages. %>
<form style="padding: 2rem; display: flex; flex-direction: column; gap: 1rem; max-width: 28rem;" action="#" method="post">
  <%= render Shipwright::InputComponent.new(
    name: "username", label: "Username",
    caption: "3–24 lowercase letters, numbers, or underscores",
    required: true, minlength: 3, maxlength: 24,
    pattern: '[a-z0-9_]+',
    title: "Lowercase letters, numbers, and underscores only",
    placeholder: "alex_j"
  ) %>

  <%= render Shipwright::InputComponent.new(
    name: "email", type: :email, label: "Email",
    caption: "We'll never share it",
    required: true, autocomplete: "email", inputmode: "email",
    placeholder: "giorgio@armani.com", leading_icon: :mail
  ) %>

  <%= render Shipwright::InputComponent.new(
    name: "age", type: :number, label: "Age",
    caption: "Must be 13 or older",
    required: true, min: 13, max: 120, step: 1
  ) %>

  <%= render Shipwright::InputComponent.new(
    name: "password", type: :password, label: "Password",
    caption: "At least 12 characters",
    required: true, minlength: 12, autocomplete: "new-password",
    leading_icon: :lock
  ) %>

  <button type="submit" class="self-start px-4 py-2 rounded-md bg-interactive-primary-default text-text-inverse text-sm font-medium">Submit</button>
</form>
