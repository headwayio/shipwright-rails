<div style="padding: 2rem; display: flex; flex-direction: column; gap: 1rem; font-family: Manrope, system-ui;">
  <% [:sm, :md, :lg].each do |size| %>
    <div style="display: flex; gap: 0.75rem; align-items: center;">
      <%= render Shipwright::AvatarComponent.new(src: "https://i.pravatar.cc/150?img=12", alt: "John Legend", size: size, status: :online) %>
      <div style="display: flex; flex-direction: column;">
        <span style="font-weight: 500;">John Legend</span>
        <span style="font-size: 0.875rem; color: #595d6a;">Senior Designer</span>
      </div>
    </div>
  <% end %>
</div>
