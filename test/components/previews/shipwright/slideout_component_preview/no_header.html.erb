<div style="padding: 2rem;">
  <button type="button"
          data-shipwright-slideout-trigger="preview-no-header"
          class="inline-flex items-center px-4 py-2 rounded-md bg-interactive-primary-default text-text-inverse text-sm font-medium cursor-pointer">
    Open minimal slideout
  </button>

  <%= render(Shipwright::SlideoutComponent.new(id: "preview-no-header", close_button: false)) do %>
    <div class="h-full flex items-center justify-center">
      <p class="text-sm text-text-secondary">A slideout with no header, no tabs, no footer — just body content.</p>
    </div>
  <% end %>
</div>
