<div style="padding: 2rem;">
  <button type="button"
          data-shipwright-slideout-trigger="preview-tabs"
          class="inline-flex items-center px-4 py-2 rounded-md bg-interactive-primary-default text-text-inverse text-sm font-medium cursor-pointer">
    Open tabbed slideout
  </button>

  <%= render(Shipwright::SlideoutComponent.new(id: "preview-tabs", title: "Settings", subtitle: "Manage your workspace")) do |s| %>
    <% s.with_tab(label: "Details",  icon: :info,     active: true) %>
    <% s.with_tab(label: "Security", icon: :lock) %>
    <% s.with_tab(label: "Billing",  icon: :"credit-card") %>

    <p class="text-sm">Select a tab above to view different settings.</p>

    <% s.with_action do %>
      <button type="button" data-shipwright-slideout-close="preview-tabs"
              class="px-4 py-3 rounded-md border border-border-interactive text-sm">Close</button>
    <% end %>
  <% end %>
</div>
