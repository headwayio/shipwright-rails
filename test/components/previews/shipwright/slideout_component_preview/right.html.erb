<div style="padding: 2rem;">
  <button type="button"
          data-shipwright-slideout-trigger="preview-right"
          class="inline-flex items-center px-4 py-2 rounded-md bg-interactive-primary-default text-interactive-on-primary text-sm font-medium cursor-pointer">
    Open right slideout
  </button>

  <%= render(Shipwright::SlideoutComponent.new(
    id: "preview-right",
    title: "Edit profile",
    subtitle: "Update your personal info"
  )) do |s| %>
    <p class="text-sm text-text-primary">This panel slides in from the right. Click the ✕, press Escape, or click the backdrop to close.</p>

    <% s.with_action do %>
      <button type="button"
              data-shipwright-slideout-close="preview-right"
              class="inline-flex items-center justify-center px-4 py-3 rounded-md border border-border-interactive bg-background-primary text-text-primary text-sm font-medium">
        Cancel
      </button>
    <% end %>
    <% s.with_action do %>
      <button type="button"
              class="inline-flex items-center justify-center px-4 py-3 rounded-md bg-interactive-primary-default text-interactive-on-primary text-sm font-medium">
        Save
      </button>
    <% end %>
  <% end %>
</div>
