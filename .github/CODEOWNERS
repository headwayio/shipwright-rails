# CODEOWNERS for shipwright-rails
#
# Reviewer auto-assignment rules. The branch protection rule on `main` /
# `develop` should be configured to "Require review from Code Owners" with
# at least 1 approving review — those settings live in GitHub repo
# settings, not in this file.
#
# Last-matching rule wins. More specific paths go LAST.
# https://docs.github.com/en/repositories/managing-your-repositories-settings-and-customizations/customizing-your-repository/about-code-owners

# Default owner for everything
*                                                       @headwayio/shipwrightdevs

# ── Design-system sync infrastructure ─────────────────────────────
# These files exist to keep this gem aligned with shipwright-ui's
# packages/theme as the canonical design system source of truth.
# Drive-by edits to tokens.css are a footgun — they'll be overwritten
# by the next sync. Same for the SHA pin and the sync script itself.

/.shipwright-theme-sha                                  @headwayio/shipwrightdevs
/bin/sync-shipwright-theme                              @headwayio/shipwrightdevs
/.github/workflows/sync-shipwright-theme.yml            @headwayio/shipwrightdevs
/.github/CODEOWNERS                                     @headwayio/shipwrightdevs

# Tailwind 4 @theme tokens — autogenerated, mirrors
# headwayio/shipwright-ui/packages/theme/src/tokens.css
/app/assets/tailwind/shipwright/tokens.css              @headwayio/shipwrightdevs

# Engine entrypoint (@source directives + token import). Not autogenerated
# but a sibling of tokens.css and equally consequential.
/app/assets/tailwind/shipwright/engine.css              @headwayio/shipwrightdevs

# ── Component surface area ────────────────────────────────────────
# Every component visually renders the design tokens, so design changes
# tend to touch them. Routing through shipwrightdevs ensures the design
# team sees every consumer before it lands.

/app/components/shipwright/                             @headwayio/shipwrightdevs

# ── Release plumbing ──────────────────────────────────────────────

/shipwright.gemspec                                     @headwayio/shipwrightdevs
/lib/shipwright/version.rb                              @headwayio/shipwrightdevs
